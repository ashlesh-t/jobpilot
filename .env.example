# ─── JobPilot secrets ────────────────────────────────────────────────────────
# Copy this file to ~/.claude/job-hunt-ai/.env and fill in the values.
# setup.sh does the copy for you. NEVER commit the filled-in .env.
# See GETTING_STARTED.md for step-by-step instructions on obtaining each value.

# REQUIRED — Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=your_apify_api_token

# REQUIRED — Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# REQUIRED — Your Telegram chat ID (see GETTING_STARTED.md "Find your chat ID")
TELEGRAM_CHAT_ID=your_telegram_chat_id

# OPTIONAL — Anthropic API key. Only needed for the metered "Anthropic API" engine
# in the local control service. The default Claude Code (subscription) engine and
# the chat-driven pipeline do NOT need this.
ANTHROPIC_API_KEY=

# OPTIONAL — Discord channel webhook URL. Set it (or paste it in the control-service
# Connections tab) and add "discord" to preferences.notify_channels to also deliver
# the digest + report + resumes to Discord.
DISCORD_WEBHOOK_URL=

# OPTIONAL — Telegram channel scraper (personal API creds from https://my.telegram.org).
# Separate from the bot token above; only needed for the Telegram job-channel source.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# OPTIONAL — Google Gemini / Antigravity engine (interface-ready, backend not yet shipped).
GEMINI_API_KEY=

# OPTIONAL — Override where JobPilot stores its data (default shown).
JOBPILOT_DIR=~/.claude/job-hunt-ai
