# Maintainer: ashlesh-t <ashleshat5@gmail.com>
# Thin AUR wrapper over the PyPI package `claude-jobpilot`. Gives `yay -S claude-jobpilot`.
# All logic lives in the Python package; this only delivers it.
pkgname=claude-jobpilot
pkgver=1.6.0
pkgrel=1
pkgdesc="Automated job-hunt pipeline for Claude Code (scrape → score → tailor → notify)"
arch=('any')
url="https://github.com/ashlesh-t/jobpilot"
license=('MIT')
depends=('python' 'python-requests' 'python-keyring' 'python-dotenv' 'python-openpyxl')
# NOTE: some deps (apify-client, telethon, tldextract, confusable-homoglyphs, urlextract,
# python-whois, pypdf2, python-docx) may need to come from AUR or be vendored into the venv.
# The simplest robust path is to install into an isolated venv at build time; see below.
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
source=("https://files.pythonhosted.org/packages/source/c/claude-jobpilot/claude_jobpilot-${pkgver}.tar.gz")
sha256sums=('SKIP')  # replace with the real sha256 of the sdist on publish

build() {
  cd "claude_jobpilot-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "claude_jobpilot-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  # runtime pip deps not packaged as Arch deps are resolved on first use / via pipx.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
